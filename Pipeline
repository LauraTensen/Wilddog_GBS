module load snakemake/8.4.2

#####################################
# make files compatible with workflow
#####################################

# put all reads in their own sample folder:
cd  /dir || exit

# Llop over fastq.gz files in current directory
for file in *.fastq.gz; do
    # extract sample name (before 1st underscore)
    sample=$(echo "$file" | cut -d'_' -f1)

    # create a directory per sample (if it doesn't already exist)
    mkdir -p "$sample"

    # move the file its directory
    mv "$file" "$sample/"
done


# snakefile Mapping_VariantCalling in separate file
snakemake --snakefile Snakefile_MappingVariantCalling --cores 40 -p -j 4 --rerun-incomplete --rerun-triggers mtime --resources mem=190000 


