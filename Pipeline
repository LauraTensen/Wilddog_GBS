module load samtools/1.20
module load perl
module load ncbi-blast/2.16.0+
module load seqkit/2.4.0

# convert aligned reads to fasta
# setup
READS=/folder/bam_files/sample_sort.bam
FASTA=/folder/fasta_reads/sample.fasta

# convert aligned reads to fasta
samtools fasta -@ 8 -F 4 -o $FASTA $READS
#-@ 8: use 8 threads
#-F 4: filter out unmapped segments
#-o: set output file

# remove duplicates
seqkit rmdup -n -o $FASTA.nodup $FASTA

# create blast database
makeblastdb -in $FASTA.nodup -title my_wgs_db_sample -dbtype nucl -out database/my_wgs_db_sample -parse_seqids
#-in: specify fasta aligned reads as input for database
#-title: specify database title
#-dbtype nucl: use nucleotide sequences as molecule type
#-out: specify output database name

echo "database created"

# blast search---------------------------------------------------------------------------------------
MHC_REF=/home/projects/ku_00287/people/lauten/Temp/WGS/MHC/MHC.fasta

# very fast 
blastn -query $MHC_REF -db database/my_wgs_db_sample -out blast_out/mhc_hits_sample.txt -evalue 1e-3 -outfmt 6 -num_threads 40
#-outfmt 6: tabular output format

echo "blast done"


# extract MHC from fasta
# extract 2nd column from blast output (seq ID), sort them, remove duplicates, save unique IDs
awk '{print $2}' blast_out/mhc_hits_sample.txt | sort | uniq > blast_out/mhc_read_ids_sample.txt

# extract MHC sequences from the fasta: option 2
blastdbcmd -db database/my_wgs_db_sample -entry_batch blast_out/mhc_read_ids_sample.txt -out mhc_out/mhc_sequences_sample.fasta

echo "mhc extracted"
