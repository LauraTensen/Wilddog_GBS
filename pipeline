       Tajima's D
----------------------------

vcftools --vcf snps_dataset_ld_filtered_noFID.vcf --TajimaD 1000

# read the VCFtools TajimaD output
tajima <- read.table("out.Tajima.D", header = TRUE, sep="\t", stringsAsFactors=FALSE)

# check the first few rows
head(tajima)
str(tajima)

# remove windows with NaN TajimaD
tajima_clean <- tajima[is.finite(tajima$TajimaD), ]

# plot using BIN_START as x-axis
plot(tajima_clean$BIN_START, tajima_clean$TajimaD,
     type='p', pch=20, cex=0.6,
     col="grey50",                      # grey points
     xlab='Genomic position (bp)',
     ylab="Tajima's D",
     main="Sliding-window Tajima's D")
abline(h=0, col="blue", lty=2, lwd=2) 

# distribution
hist(tajima_clean$TajimaD,
     breaks=50,              # number of bins
     col="grey70",
     border="white",
     xlab="Tajima's D",
     main="Distribution of Tajima's D values")
abline(v=0, col="blue", lwd=2, lty=2)  # neutral line

#density plot
plot(density(tajima_clean$TajimaD, na.rm=TRUE),
     main="Density of Tajima's D values",
     xlab="Tajima's D", ylab="Density",
     col="grey50", lwd=2)
abline(v=0, col="blue", lty=2, lwd=2)
