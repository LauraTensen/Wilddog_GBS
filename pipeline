# Rule of thumb:
# Take PCs before the elbow
# Often K = 2–5 for SNP panels
# Don’t overfit — too many PCs = loss of power

# Then rerun:
pc <- pcadapt("data.bed", K = 3)

# Check structure
plot(pc, option = "scores", i = 1, j = 2)

# Identify candidate SNPs
plot(pc, option = "manhattan")

# Extract results:
